{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/app.js",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "ts-node-dev src/app.ts",
    "build": "tsc",
    "start": "npm run migrate && node dist/app.js",
    "sequelize": "sequelize --config sequelize-config.js",
    "migrate": "npx sequelize-cli db:migrate --config sequelize-config.js",
    "seed": "npx sequelize-cli db:seed:all --config sequelize-config.js",
    "check:auth": "ts-node --transpile-only src/__checks__/authorization.check.ts",
    "test": "npm run check:auth"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "overrides": {
    "body-parser": "^2.2.2",
    "jws": "^3.2.3",
    "lodash": "^4.17.23",
    "qs": "^6.14.1",
    "validator": "^13.15.26",
    "brace-expansion": "^1.1.12",
    "diff": "^4.0.4",
    "glob": "^8.1.0",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.2",
    "sequelize-typescript": "^2.1.6",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "snyk": "^1.1308.3",
    "sqlite3": "^6.0.1",
    "ts-node-dev": "^2.0.0"
  }
}
